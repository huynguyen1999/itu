JWT_ACCESS_SECRET="replace-me-access"
JWT_REFRESH_SECRET="replace-me-refresh"
LOG_CONSOLE="true"
LOG_LEVEL="debug"
LOG_PATH="./logs"
LOG_HTTP_BODY_LIMIT_BYTES="8192"
