{
  "name": "@quiz-me/api",
  "private": true,
  "version": "0.1.0",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"prisma/**/*.ts\" \"*.json\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"prisma/**/*.ts\" \"*.json\"",
    "test": "jest",
    "typecheck": "tsc --noEmit --incremental false",
    "sync:e2e:websocket": "tsx scripts/sync-websocket-e2e.ts",
    "prisma:generate": "dotenv -e .env -- prisma generate",
    "prisma:validate": "dotenv -e .env -- prisma validate",
    "prisma:migrate": "dotenv -e .env -- prisma migrate dev",
    "prisma:migration:create": "dotenv -e .env -- prisma migrate dev --create-only",
    "prisma:deploy": "dotenv -e .env -- prisma migrate deploy",
    "prisma:seed": "dotenv -e .env -- tsx prisma/seed.ts",
    "journal:reset-dev": "dotenv -e .env -- tsx scripts/reset-journal-dev.ts",
    "architecture:check": "node ../tools/check-architecture.mjs",
    "architecture:verify": "yarn architecture:check"
  },
  "dependencies": {
    "@fastify/compress": "^9.0.0",
    "@fastify/cookie": "^11.0.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/static": "^9.1.3",
    "@google/genai": "^1.0.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/microservices": "^11.1.28",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-fastify": "^11.0.0",
    "@nestjs/serve-static": "^5.0.0",
    "@nestjs/swagger": "^11.4.6",
    "@prisma/client": "^6.0.0",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^2.0.1",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "ical.js": "^2.2.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.33.5",
    "undici": "^8.7.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.43",
    "@types/amqplib": "^0.10.8",
    "@types/bcrypt": "^5.0.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/passport-jwt": "^4.0.1",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.5.3",
    "prisma": "^6.0.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0"
  }
}
