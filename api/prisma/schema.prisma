/// Immutable-at-award-time routing from a SKILL's XP to one or two ATTRIBUTEs.
/// Mapping rows are user-owned and may only point at skills/attributes owned by
/// the same user; service validation enforces the cross-row 100% invariant.
model GrowthAttributeMapping {
  id          String                     @id
  userId      String
  skillId     String
  attributeId String
  slot        GrowthAttributeMappingSlot
  weight      Int
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt
  user        User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill       GrowthSkill                @relation("GrowthAttributeMappingSkill", fields: [skillId], references: [id], onDelete: Cascade)
  attribute   GrowthSkill                @relation("GrowthAttributeMappingAttribute", fields: [attributeId], references: [id], onDelete: Restrict)

  @@unique([skillId, slot])
  @@unique([skillId, attributeId])
  @@index([userId, skillId])
  @@index([userId, attributeId])
}

