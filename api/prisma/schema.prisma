generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OAuthProvider {
  GOOGLE
}

enum CalendarProvider {
  GOOGLE
  ICS
}

enum CalendarConnectionStatus {
  CONNECTED
  ERROR
  DISCONNECTED
}

enum CardType {
  BASIC
  REVERSE
}

enum CardStatus {
  ACTIVE
  ARCHIVED
}

enum CardSide {
  PROMPT
  ANSWER
}

enum ReviewDirection {
  FRONT_TO_BACK
  BACK_TO_FRONT
}

enum ReviewGrade {
  AGAIN
  HARD
  GOOD
  EASY
}

enum StudyMode {
  DUE
  CRAM
}

enum AiJobType {
  CARD_GENERATION
  SESSION_FEEDBACK
  REVIEW_INSIGHTS
}

enum AiJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum AiCredentialStatus {
  HEALTHY
  RATE_LIMITED
  QUOTA_EXHAUSTED
  INVALID_KEY
  PROVIDER_ERROR
}

enum ScheduledJobType {
  ACCOUNT_DELETE
  TRASH_PURGE
  TASK_REMINDER
}

enum ScheduledJobStatus {
  SCHEDULED
  PUBLISHING
  PUBLISHED
  RUNNING
  COMPLETED
  FAILED
  CANCELED
}

enum SyncDevicePlatform {
  IOS
  WATCHOS
  WEB
  MACOS
}

enum TaskPriority {
  NONE
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  INBOX
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELED
  ARCHIVED
}

enum ReminderStatus {
  SCHEDULED
  SNOOZED
  DISMISSED
  DELIVERED
  CANCELED
}

enum ReminderType {
  ABSOLUTE
  RELATIVE
}

enum ReminderRelativeTo {
  DUE_AT
  SCHEDULE_START_AT
}

enum FocusMode {
  COUNTDOWN
  STOPWATCH
}

enum FocusPhase {
  WORK
  SHORT_BREAK
  LONG_BREAK
}

enum FocusSessionStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ABANDONED
}

enum FocusSoundSource {
  UPLOAD
}

enum HabitTargetType {
  BOOLEAN
  COUNT
  DURATION
  QUANTITY
}

enum HabitScheduleType {
  WEEKDAYS
  INTERVAL
  TIMES_PER_PERIOD
}

enum HabitOccurrenceStatus {
  PENDING
  COMPLETED
  FAILED
  SKIPPED
}

enum HabitDirection {
  BUILD
  LIMIT
}

enum HabitProgressSource {
  MANUAL
  FOCUS_SESSION
  TASK_COMPLETION
  HEALTH
  SCREEN_TIME
  CALENDAR
  EXTERNAL
}

enum CommitmentPolicyLevel {
  GENTLE
  STANDARD
}

enum HabitCommitmentState {
  NONE
  COMMITTED
  BREACHED
  RECOVERED
  EXCUSED
}

enum CommitmentPenaltyState {
  ACTIVE
  REVERSED
}

enum HabitTaskSyncPolicy {
  NONE
  TASK_TO_HABIT
  HABIT_TO_TASK
  BIDIRECTIONAL
}

enum GrowthSourceType {
  TASK
  HABIT
  FOCUS_PRESET
  REVIEW_DECK
}

enum GrowthProgressKind {
  ATTRIBUTE
  SKILL
}

enum GrowthAttributeMappingSlot {
  PRIMARY
  SECONDARY
}

enum GrowthCurrency {
  ACCOUNT_XP
  SKILL_XP
  COIN
}

enum GrowthLedgerKind {
  ACTIVITY_AWARD
  REVERSAL
  COMMITMENT_PENALTY
  REWARD_PURCHASE
  ADMINISTRATIVE_ADJUSTMENT
  RESET_ADJUSTMENT
}

enum GrowthRewardPreset {
  LIGHT
  STANDARD
  STRONG
}

enum GrowthResetScope {
  SKILL
  ALL_XP
  FULL
}

enum GrowthOnboardingState {
  NOT_STARTED
  SKILLS_OFFERED
  COMPLETED
}

enum GrowthScalingMode {
  FIXED
  LINEAR
}

enum GrowthInventoryTransactionKind {
  PURCHASE
  TASK_AWARD
  CONSUMPTION
  REVERSAL
  ADJUSTMENT
}

model User {
  id                          String                       @id
  email                       String?                      @unique
  username                    String?                      @unique
  displayName                 String?
  passwordHash                String?
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  deletionRequestedAt         DateTime?
  deletionScheduledFor        DateTime?
  deletedAt                   DateTime?
  bannedAt                    DateTime?
  oauth                       OAuthIdentity[]
  refreshSessions             RefreshSession[]
  oauthHandoffs               OAuthHandoff[]
  decks                       Deck[]
  sessions                    StudySession[]
  aiJobs                      AiJob[]
  aiCredentials               AiCredential[]
  scheduledJobs               ScheduledJob[]
  syncDevices                 SyncDevice[]
  roles                       UserRole[]
  taskLists                   TaskList[]
  tasks                       Task[]
  taskTags                    TaskTag[]
  taskSections                TaskSection[]
  taskReminders               TaskReminder[]
  notifications               Notification[]
  taskOccurrences             TaskOccurrence[]
  focusPresets                FocusPreset[]
  focusPolicies               FocusPolicy[]
  focusSessions               FocusSession[]
  focusSounds                 FocusSound[]
  focusSoundPreferences       FocusSoundPreference[]
  habits                      Habit[]
  habitTimeBlocks             HabitTimeBlock[]
  habitTaskTemplates          HabitTaskTemplate[]
  growthSkills                GrowthSkill[]
  growthAttributeMappings    GrowthAttributeMapping[]
  growthEarningRules          GrowthEarningRule[]
  growthLedgerEntries         GrowthLedgerEntry[]
  growthShopRewards           GrowthShopReward[]
  growthRewardRedemptions     GrowthRewardRedemption[]
  growthItemCategories        GrowthItemCategory[]
  growthInventoryTransactions GrowthInventoryTransaction[]
  growthRewardPresetSettings  GrowthRewardPresetSetting[]
  growthTaskRewardDefaults    GrowthTaskRewardDefault[]
  growthProfile               GrowthProfile?
  growthCycles                GrowthCycle[]
  growthResets                GrowthReset[]
  growthCommitmentPolicies     HabitCommitmentPolicy[]
  commitmentPenalties         GrowthCommitmentPenalty[]
  syncFieldClocks             SyncFieldClock[]
  journalEntries              JournalEntry[]
  journalTemplates            JournalTemplate[]
  journalTags                 JournalTag[]
  budgetCategories            BudgetCategory[]
  budgetPeriods               BudgetPeriod[]
  budgetTransactions          BudgetTransaction[]
  exerciseDefinitions         ExerciseDefinition[]
  gymWorkouts                 GymWorkout[]
  journalAttachments         JournalAttachment[]
  preferences                 UserPreferences?
  usageSummaries              UsageSummary[]
  usageAppIdentities          UsageAppIdentity[]
  websiteUsageSummaries       WebsiteUsageSummary[]
  websiteActivitySessions     WebsiteActivitySession[]
  browserExtensionCredential  BrowserExtensionCredential?
  calendarConnections         CalendarConnection[]
  externalCalendars           ExternalCalendar[]
  externalCalendarEvents      ExternalCalendarEvent[]
}

model UserPreferences {
  userId             String   @id
  taskPreferences    Json     @default("{}")
  focusPreferences   Json     @default("{}")
  habitPreferences   Json     @default("{}")
  matrixPreferences  Json     @default("{}")
  growthPreferences  Json     @default("{}")
  learnPreferences   Json     @default("{}")
  journalPreferences Json     @default("{}")
  moneyPreferences   Json     @default("{}")
  budgetPreferences  Json     @default("{}")
  gymPreferences     Json     @default("{}")
  usagePreferences   Json     @default("{}")
  calendarPreferences Json     @default("{}")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Role {
  id          String           @id
  name        String           @unique
  description String?
  isDefault   Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id
  key         String           @unique
  description String
  category    String
  createdAt   DateTime         @default(now())
  roles       RolePermission[]
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId])
  @@index([roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model RefreshSession {
  id                       String    @id
  userId                   String
  tokenHash                String    @unique
  expiresAt                DateTime
  revokedAt                DateTime?
  rotationGraceUntil       DateTime?
  rotationRecoveryUsedAt   DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  user                     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model OAuthHandoff {
  id         String    @id
  userId     String?
  codeHash   String    @unique
  payload    Json
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model RateLimitBucket {
  key       String   @id
  count     Int
  resetAt   DateTime
  updatedAt DateTime @updatedAt
}

model SyncDevice {
  id                     String             @id
  userId                 String
  platform               SyncDevicePlatform
  pushToken              String?
  lastSeenAt             DateTime           @default(now())
  lastKnownSyncCursor    String?
  notificationPreference Json?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  usageSummaries         UsageSummary[]
  websiteUsageSummaries  WebsiteUsageSummary[]

  @@index([userId, platform])
  @@index([userId, lastSeenAt])
}

model UsageSummary {
  userId        String
  syncDeviceId  String
  localDate     DateTime   @db.Date
  hour          Int        @default(-1)
  bundleId      String
  displayName   String
  timezone      String
  activeSeconds Int
  engagedSeconds Int?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  syncDevice    SyncDevice @relation(fields: [syncDeviceId], references: [id], onDelete: Cascade)

  @@id([syncDeviceId, localDate, hour, bundleId])
  @@index([userId, localDate])
  @@index([syncDeviceId, localDate])
}

model UsageAppIdentity {
  userId         String
  bundleId       String
  displayName    String
  iconHash       String?
  iconStorageKey String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, bundleId])
}

model WebsiteUsageSummary {
  userId             String
  syncDeviceId       String
  localDate          DateTime   @db.Date
  browserBundleId    String
  browserDisplayName String
  hostname           String
  url                String?    @db.Text
  urlKey             String
  timezone           String
  activeSeconds      Int
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  syncDevice         SyncDevice @relation(fields: [syncDeviceId], references: [id], onDelete: Cascade)

  @@id([syncDeviceId, localDate, browserBundleId, urlKey])
  @@index([userId, localDate])
  @@index([userId, localDate, hostname])
  @@index([syncDeviceId, localDate])
}

model WebsiteActivitySession {
  id                String
  userId            String
  installationId    String
  browserBundleId   String
  browserDisplayName String
  startedAt         DateTime
  endedAt           DateTime
  activeSeconds     Int
  hostname          String
  url               String    @db.Text
  iconUrl           String?   @db.Text
  pageTitle         String?   @db.Text
  isPrivate         Boolean   @default(false)
  timezone          String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([installationId, id])
  @@unique([userId, installationId, id])
  @@index([userId, startedAt])
  @@index([userId, hostname, startedAt])
  @@index([userId, url, startedAt])
  @@index([userId, installationId, startedAt])
}

model BrowserExtensionCredential {
  id        String   @id
  userId    String   @unique
  keyHash   String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OAuthIdentity {
  id             String        @id
  userId         String
  provider       OAuthProvider
  providerUserId String
  createdAt      DateTime      @default(now())
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
}

model Deck {
  id          String    @id
  userId      String
  title       String
  description String?
  icon        DeckIcon  @default(BOOK)
  color       DeckColor @default(TEAL)
  isDefault   Boolean   @default(false)
  archived    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  version     Int       @default(1)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards       Card[]

  @@index([userId, archived])
}

model Card {
  id             String        @id
  deckId         String
  userId         String
  type           CardType
  status         CardStatus    @default(ACTIVE)
  promptRichText String
  answerRichText String
  tags           String[]      @default([])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  version        Int           @default(1)
  deck           Deck          @relation(fields: [deckId], references: [id])
  images         CardImage[]
  reviewStates   ReviewState[]

  @@index([userId, deckId, status])
}

model CardImage {
  id         String    @id
  cardId     String
  userId     String
  side       CardSide
  storageKey String
  url        String
  mimeType   String
  width      Int
  height     Int
  sizeBytes  Int
  sortOrder  Int       @default(0)
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?
  card       Card      @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([userId, cardId, side])
  @@index([userId, deletedAt])
}

model ReviewState {
  id           String          @id
  userId       String
  cardId       String
  direction    ReviewDirection
  dueAt        DateTime
  stability    Float           @default(0)
  difficulty   Float           @default(5)
  intervalDays Int             @default(0)
  lapseCount   Int             @default(0)
  reviewCount  Int             @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  card         Card            @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([cardId, direction])
  @@index([userId, dueAt])
}

model StudySession {
  id          String             @id
  userId      String?
  deckId      String?
  mode        StudyMode
  rating      Int?
  startedAt   DateTime           @default(now())
  completedAt DateTime?
  reviewed    Int                @default(0)
  correct     Int                @default(0)
  growthReceipt Json?
  user        User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  reviewLogs  ReviewLog[]
  feedback    AiSessionFeedback?

  @@index([userId, startedAt])
}

model ReviewLog {
  id                 String          @id
  idempotencyKey     String?
  userId             String
  sessionId          String
  cardId             String
  cardDeckId         String?
  cardPromptRichText String          @default("")
  cardAnswerRichText String          @default("")
  cardImages         Json            @default("[]")
  direction          ReviewDirection
  grade              ReviewGrade
  userAnswer         String?
  responseMs         Int?
  previousDueAt      DateTime?
  nextDueAt          DateTime
  previousInterval   Int
  nextInterval       Int
  createdAt          DateTime        @default(now())
  session            StudySession    @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@index([userId, sessionId])
  @@index([cardId, createdAt])
  @@index([userId, cardDeckId, createdAt])
  @@unique([userId, idempotencyKey])
}

enum DeckIcon {
  INBOX
  BOOK
  BRAIN
  LANGUAGE
  FLASK
  CODE
  LEAF
  CALCULATOR
  GLOBE
}

enum DeckColor {
  SLATE
  EMERALD
  TEAL
  BLUE
  INDIGO
  VIOLET
  ROSE
  AMBER
}

model AiJob {
  id          String      @id
  userId      String?
  type        AiJobType
  status      AiJobStatus @default(QUEUED)
  input       Json
  output      Json?
  error       String?
  attempts    Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  completedAt DateTime?
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, status, createdAt])
}

model AiCredential {
  id             String             @id
  userId         String
  encryptedApiKey String
  keyHint        String
  enabled        Boolean            @default(true)
  status         AiCredentialStatus @default(HEALTHY)
  lastError      String?
  lastUsedAt     DateTime?
  cooldownUntil  DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, enabled, status, cooldownUntil, lastUsedAt])
}

model AiSessionFeedback {
  id         String       @id
  userId     String
  sessionId  String       @unique
  summary    String
  weakAreas  String[]     @default([])
  nextSteps  String[]     @default([])
  confidence Float?
  createdAt  DateTime     @default(now())
  session    StudySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model ScheduledJob {
  id          String             @id
  userId      String?
  type        ScheduledJobType
  status      ScheduledJobStatus @default(SCHEDULED)
  payload     Json
  runAt       DateTime
  attempts    Int                @default(0)
  lastError   String?
  lockedAt    DateTime?
  publishedAt DateTime?
  completedAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  user        User?              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, runAt])
  @@index([status, lockedAt])
  @@index([userId, status, runAt])
}

model SyncMutation {
  id          String   @id
  userId      String
  deviceId    String
  kind        String
  entityId    String
  payload     Json
  result      Json?
  occurredAt  DateTime
  processedAt DateTime @default(now())

  @@index([userId, processedAt])
}

model SyncChange {
  cursor     Int      @id @default(autoincrement())
  userId     String
  entityType String
  entityId   String
  operation  String
  data       Json?
  createdAt  DateTime @default(now())

  @@index([userId, cursor])
}

model TaskList {
  id                   String                    @id
  userId               String
  title                String
  description          String?
  color                String                    @default("TEAL")
  isDefault            Boolean                   @default(false)
  archivedAt           DateTime?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  version              Int                       @default(1)
  user                 User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks                Task[]
  habits               Habit[]
  sections             TaskSection[]
  growthRewardDefaults GrowthTaskRewardDefault[]

  @@index([userId, archivedAt, updatedAt])
  @@index([userId, isDefault])
}

model Task {
  id                      String              @id
  userId                  String
  taskListId              String?
  sectionId               String?
  parentId                String?
  title                   String
  descriptionMarkdown     String              @default("")
  priority                TaskPriority        @default(NONE)
  important               Boolean             @default(false)
  urgentOverride          Boolean?
  scheduledStartAt        DateTime?
  scheduledEndAt          DateTime?
  dueAt                   DateTime?
  sourceHabitDate         DateTime?
  estimatedMinutes        Int?
  recurrenceRule          String?
  status                  TaskStatus          @default(INBOX)
  sortOrder               Float               @default(0)
  completedAt             DateTime?
  archivedAt              DateTime?
  deletedAt               DateTime?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  version                 Int                 @default(1)
  user                    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskList                TaskList?           @relation(fields: [taskListId], references: [id], onDelete: SetNull)
  section                 TaskSection?        @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  parent                  Task?               @relation("TaskChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children                Task[]              @relation("TaskChildren")
  tags                    TaskTagAssignment[]
  reminders               TaskReminder[]
  occurrences             TaskOccurrence[]
  focusSessions           FocusSession[]
  generatedByHabits       Habit[]             @relation("HabitTaskTemplate")
  sourceHabitId           String?
  sourceHabitOccurrenceId String?             @unique
  sourceHabit             Habit?              @relation("HabitSupportingTasks", fields: [sourceHabitId], references: [id], onDelete: SetNull)
  sourceHabitOccurrence   HabitOccurrence?    @relation(fields: [sourceHabitOccurrenceId], references: [id], onDelete: SetNull)

  @@index([userId, status, dueAt])
  @@index([userId, sortOrder])
  @@index([userId, scheduledStartAt])
  @@index([userId, deletedAt])
  @@index([taskListId, status])
  @@index([sectionId, sortOrder])
  @@index([parentId])
  @@index([sourceHabitId])
  @@unique([userId, sourceHabitId, sourceHabitDate])
}

model TaskSection {
  id         String    @id
  userId     String
  taskListId String?
  title      String
  sortOrder  Float     @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  version    Int       @default(1)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskList   TaskList? @relation(fields: [taskListId], references: [id], onDelete: Cascade)
  tasks      Task[]

  @@index([userId, taskListId, sortOrder])
}

model TaskTag {
  id        String               @id
  userId    String
  name      String
  color     String               @default("SLATE")
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks     TaskTagAssignment[]
  habits    HabitTagAssignment[]

  @@unique([userId, name])
  @@index([userId, name])
}

model TaskTagAssignment {
  taskId String
  tagId  String
  task   Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag    TaskTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
  @@index([tagId])
}

model TaskReminder {
  id             String         @id
  userId         String
  taskId         String
  type           ReminderType   @default(ABSOLUTE)
  remindAt       DateTime
  relativeTo     ReminderRelativeTo?
  offsetMinutes  Int?
  calendarDayOffset Int?
  timeOfDayMinutes Int?
  timeZone       String?
  status         ReminderStatus @default(SCHEDULED)
  persistent     Boolean        @default(false)
  snoozedFrom    DateTime?
  deliveredAt    DateTime?
  scheduledJobId String?        @unique
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  task           Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  notification   Notification?

  @@index([userId, status, remindAt])
  @@index([remindAt, status])
  @@index([taskId])
}

model CalendarConnection {
  id                 String                   @id
  userId             String
  provider           CalendarProvider
  accountEmail       String?
  encryptedRefreshToken String?
  accessTokenExpiresAt DateTime?
  status             CalendarConnectionStatus @default(CONNECTED)
  lastError          String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  user               User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  calendars          ExternalCalendar[]

  @@index([userId])
  @@unique([userId, provider, accountEmail])
}

model ExternalCalendar {
  id                   String              @id
  userId               String
  connectionId         String?
  provider             CalendarProvider
  providerCalendarId   String?
  name                 String
  url                  String?
  color                String              @default("BLUE")
  visible              Boolean             @default(true)
  syncToken            String?
  etag                 String?
  lastModified         String?
  lastFetchedAt        DateTime?
  lastSuccessfulSyncAt DateTime?
  lastError            String?
  channelId            String?
  resourceId           String?
  channelExpiration    DateTime?
