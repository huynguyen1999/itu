  priceSnapshot       Int
  redeemedAt          DateTime          @default(now())
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  reward              GrowthShopReward  @relation(fields: [rewardId], references: [id], onDelete: Restrict)
  ledgerEntry         GrowthLedgerEntry @relation(fields: [ledgerEntryId], references: [id], onDelete: Restrict)

  @@index([userId, redeemedAt])
  @@index([rewardId, redeemedAt])
}

model SyncFieldClock {
  id         String   @id @default(uuid())
  userId     String
  entityType String
  entityId   String
  fieldName  String
  editedAt   DateTime
  deviceId   String
  mutationId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entityType, entityId, fieldName])
  @@index([userId, entityType, entityId])
}

enum JournalEntryKind {
  NOTE
  WEEKLY_REVIEW
  DAILY_REVIEW
}

enum TransactionType {
  EXPENSE
  INCOME
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  E_WALLET
  OTHER
}

enum WeightUnit {
  KG
  LBS
}

enum WorkoutSetType {
  WARMUP
  WARM_UP
  NORMAL
  DROP
  FAILURE
}

enum ExerciseMetricType {
  WEIGHT_REPS
  REPS
  DURATION
  DISTANCE_DURATION
}

model JournalEntry {
  id              String                 @id
  userId          String
  kind            JournalEntryKind
  title           String
  contentMarkdown String                 @default("")
  entryDate       DateTime               @db.Date
  timezone        String                 @default("UTC")
  templateId      String?
  version         Int                    @default(1)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  deletedAt       DateTime?
  deletedByDeviceId String?
  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  template        JournalTemplate?       @relation(fields: [templateId], references: [id], onDelete: SetNull)
  weeklyReview    JournalWeeklyReview?
  dailyReview     JournalDailyReview?
  revisions       JournalEntryRevision[]
  tags            JournalTagAssignment[]
  attachments     JournalAttachment[]

  @@index([userId, entryDate])
  @@index([userId, kind, entryDate])
  @@index([userId, deletedAt])
}

model JournalWeeklyReview {
  entryId         String       @id
  periodStart     DateTime     @db.Date
  periodEnd       DateTime     @db.Date
  summarySnapshot Json
  wentWellMarkdown String?
  frictionMarkdown String?
  learnedMarkdown String?
  differentFromLastWeekMarkdown String?
  nextWeekMarkdown String?
  experimentSnapshot Json?
  comparisonSnapshot Json?
  aiInsightsSnapshot Json?
  aiGenerationJobId String?
  aiGeneratedAt DateTime?
  aiPromptVersion String?
  aiSourceEntryVersion Int?
  entry           JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([periodStart, periodEnd])
}

model JournalDailyReview {
  entryId              String       @id
  periodDate            DateTime     @db.Date
  summarySnapshot      Json         @default("{}")
  wentWellMarkdown     String?
  frictionMarkdown     String?
  learnedMarkdown      String?
  contextMarkdown      String?
  aiInsightsSnapshot   Json?
  aiGenerationJobId    String?
  aiGeneratedAt        DateTime?
  aiPromptVersion      String?
  aiSourceEntryVersion Int?
  entry                JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([periodDate])
}

enum GymWorkoutStatus {
  IN_PROGRESS
  COMPLETED
}

model BudgetCategory {
  id         String                @id
  userId     String
  name       String
  type       TransactionType       @default(EXPENSE)
  icon       String?
  color      String?               @default("TEAL")
  sortOrder  Int                   @default(0)
  archivedAt DateTime?
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  version    Int                   @default(1)
  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  limits     BudgetCategoryLimit[]
  transactions BudgetTransaction[]

  @@unique([userId, name])
  @@index([userId, archivedAt])
  @@map("MoneyCategory")
}

model BudgetPeriod {
  id              String                @id
  userId          String
  period          String                // e.g. "2026-08"
  currency        String                @default("VND")
  overallLimit    Decimal               @db.Decimal(18, 2)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  version         Int                   @default(1)
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryBudgets BudgetCategoryLimit[]

  @@unique([userId, period])
  @@index([userId, period])
  @@map("MoneyBudgetPeriod")
}

model BudgetCategoryLimit {
  id             String            @id
  budgetPeriodId String
  categoryId     String
  limit          Decimal           @db.Decimal(18, 2)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  budgetPeriod   BudgetPeriod      @relation(fields: [budgetPeriodId], references: [id], onDelete: Cascade)
  category       BudgetCategory    @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([budgetPeriodId, categoryId])
  @@map("MoneyCategoryBudget")
}

model BudgetTransaction {
  id             String          @id
  userId         String
  type           TransactionType  @default(EXPENSE)
  amount         Decimal         @db.Decimal(18, 2)
  currency       String          @default("VND")
  categoryId     String
  merchant       String?
  paymentMethod  PaymentMethod   @default(CASH)
  accountId      String?
  transactionAt  DateTime        @default(now())
  note           String?
  version        Int             @default(1)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?
  deletedByDeviceId String?
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryRel    BudgetCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([userId, transactionAt])
  @@index([userId, deletedAt])
  @@index([categoryId, transactionAt])
}

model ExerciseDefinition {
  id                   String                   @id
  userId               String
  name                 String
  normalizedName       String
  description          String?
  imageStorageKey      String?
  imageUrl             String?
  metricType           ExerciseMetricType       @default(WEIGHT_REPS)
  equipment            String?
  primaryMuscleGroup   String?
  secondaryMuscleGroups String[]               @default([])
  defaultWeightUnit    WeightUnit               @default(KG)
  defaultRestSeconds   Int?
  archivedAt           DateTime?
  deletedAt            DateTime?
  deletedByDeviceId    String?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  version              Int                      @default(1)
  user                 User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gymWorkoutExercises   GymWorkoutExercise[]

  @@unique([userId, normalizedName])
  @@index([userId, name])
  @@index([userId, archivedAt])
  @@index([userId, deletedAt])
}

model GymWorkout {
  id              String          @id
  userId          String
  title           String?
  source          String?
  status          GymWorkoutStatus @default(IN_PROGRESS)
  startedAt       DateTime?
  endedAt         DateTime?
  durationMinutes Int?
  version         Int             @default(1)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?
  deletedByDeviceId String?
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises       GymWorkoutExercise[]

  @@index([userId, startedAt])
  @@index([userId, deletedAt])
  @@index([userId, status])
}

model GymWorkoutExercise {
  id             String          @id
  workoutId      String
  exerciseId     String
  exerciseName   String
  metricType     ExerciseMetricType
  weightUnit     WeightUnit
  sortOrder      Int             @default(0)
  note           String?
  restSeconds    Int?
  version        Int              @default(1)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?
  deletedByDeviceId String?
  workout        GymWorkout      @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise       ExerciseDefinition @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  sets           GymWorkoutSet[]

  @@index([workoutId, sortOrder])
  @@index([workoutId, deletedAt])
  @@index([exerciseId])
}

model GymWorkoutSet {
  id                String            @id
  workoutExerciseId String
  sortOrder         Int               @default(0)
  type              WorkoutSetType     @default(NORMAL)
  reps              Int?
  weight            Decimal?          @db.Decimal(8, 2)
  durationSeconds   Int?
  distanceMeters    Float?
  rpe               Decimal?          @db.Decimal(3, 1)
  completedAt       DateTime?
  version           Int               @default(1)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?
  deletedByDeviceId String?
  workoutExercise   GymWorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)

  @@index([workoutExerciseId, sortOrder])
  @@index([workoutExerciseId, deletedAt])
}

model JournalTemplate {
  id            String           @id
  userId        String
  name          String
  entryKind     JournalEntryKind
  titleTemplate String           @default("")
  bodyMarkdown  String           @default("")
  defaults      Json             @default("{}")
  builtIn       Boolean          @default(false)
  archivedAt    DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  version       Int              @default(1)
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries       JournalEntry[]

  @@index([userId, entryKind, archivedAt])
}

model JournalTag {
  id        String                 @id
  userId    String
  name      String
  color     String                 @default("SLATE")
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries   JournalTagAssignment[]

  @@unique([userId, name])
  @@index([userId, name])
}

model JournalTagAssignment {
  entryId String
  tagId   String
  entry   JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  tag     JournalTag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([entryId, tagId])
  @@index([tagId])
}

model JournalAttachment {
  id         String       @id
  userId     String
  entryId    String
  fileName   String
  mimeType   String
  sizeBytes  Int
  storageKey String
  createdAt  DateTime     @default(now())
  deletedAt  DateTime?
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  entry      JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([userId, entryId])
  @@index([userId, deletedAt])
}

model JournalEntryRevision {
  id             String       @id
  entryId        String
  revisionNumber Int
  snapshot       Json
  mutationId     String?
  deviceId       String?
  createdAt      DateTime     @default(now())
  entry          JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([entryId, revisionNumber])
  @@index([entryId, createdAt])
}
